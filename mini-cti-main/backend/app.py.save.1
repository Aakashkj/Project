from flask import Flask, request, jsonify
from web3 import Web3
from flask_cors import CORS
import json

app = Flask(__name__)
CORS(app)

# 🔗 CONNECT TO BLOCKCHAIN
ganache_url = "http://127.0.0.1:8545"  # change if needed
web3 = Web3(Web3.HTTPProvider(ganache_url))

# CHECK CONNECTION
    print("Connected to Blockchain ✅")
else:
    print("Connection Failed ❌")

# 🏗 CONTRACT DETAILS
contract_address = Web3.to_checksum_address("0x5b1869D9A4C187F2EAa108f3062412ecf0526b24")

# 👉 PASTE FULL ABI HERE (complete one from artifacts)
contract_abi = []   # <<< replace this with FULL ABI list

contract = web3.eth.contract(
    address=contract_address,
    abi=contract_abi
)

# ---------------- ROUTES ---------------- #

@app.route("/")
def home():
    return "CTI Backend Connected 🚀"

@app.route("/cti", methods=["POST"])
def register_cti():
    data = request.json
    hash_value = data["hash"]

    tx = contract.functions.registerCTI(hash_value).transact({
        "from": web3.eth.accounts[0]
    })

    return jsonify({"status": "CTI registered", "tx": str(tx.hex())})





